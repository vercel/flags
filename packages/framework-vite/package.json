{
  "name": "@flags-sdk/vite",
  "description": "The Vite plugin of the Flags SDK, for the framework packages",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Dominik Ferber <dominik@vercel.com>",
  "homepage": "https://flags-sdk.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/flags.git"
  },
  "bugs": {
    "url": "https://github.com/vercel/flags/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "biome check",
    "type-check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "flags": "workspace:*",
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "flags": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "@types/node": "22.14.0",
    "vitest": "4.1.11",
    "vite": "8.3.4"
  }
}
