{
  "name": "flags",
  "version": "4.3.1",
  "description": "Flags SDK by Vercel: the feature flags toolkit, built on OpenFeature",
  "keywords": [
    "feature flags",
    "Next.js",
    "react",
    "toolbar",
    "overrides",
    "SvelteKit"
  ],
  "author": "Dominik Ferber <dominik@vercel.com>",
  "homepage": "https://flags-sdk.dev",
  "bugs": {
    "url": "https://github.com/vercel/flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/flags.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./default-provider": {
      "import": "./dist/default-provider.js",
      "require": "./dist/default-provider.cjs"
    },
    "./framework": {
      "import": "./dist/framework.js",
      "require": "./dist/framework.cjs"
    },
    "./config": {
      "import": "./dist/config-module.js",
      "require": "./dist/config-module.cjs"
    },
    "./manifest": {
      "import": "./dist/manifest.js",
      "require": "./dist/manifest.cjs"
    },
    "./tooling": {
      "import": "./dist/tooling.js",
      "require": "./dist/tooling.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "tooling": [
        "dist/tooling.d.ts",
        "dist/tooling.d.cts"
      ],
      "config": [
        "dist/config-module.d.ts",
        "dist/config-module.d.cts"
      ],
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "attw": "attw --pack .",
    "build": "tsup",
    "dev": "tsup --watch --clean=false",
    "prepublishOnly": "node scripts/check-temporary.mjs",
    "check": "biome check",
    "test": "vitest --run",
    "test:playground": "vitest --run playground --reporter=verbose",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc -p test/register/tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@openfeature/core": "1.12.0",
    "@openfeature/server-sdk": "1.23.0",
    "@types/node": "22.14.0",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0",
    "jose": "^6.2.12"
  },
  "bin": {
    "flags": "./dist/cli.js"
  }
}
