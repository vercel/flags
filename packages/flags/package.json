{
  "name": "flags",
  "version": "4.3.1",
  "description": "Flags SDK by Vercel - The feature flags toolkit for Next.js and SvelteKit",
  "keywords": [
    "feature flags",
    "Next.js",
    "react",
    "toolbar",
    "overrides",
    "SvelteKit"
  ],
  "author": "Dominik Ferber <dominik@vercel.com>",
  "homepage": "https://flags-sdk.dev",
  "bugs": {
    "url": "https://github.com/vercel/flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/flags.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./default-provider": {
      "import": "./dist/default-provider.js",
      "require": "./dist/default-provider.cjs"
    },
    "./integration": {
      "import": "./dist/integration.js",
      "require": "./dist/integration.cjs"
    },
    "./config": {
      "import": "./dist/config-module.js",
      "require": "./dist/config-module.cjs"
    },
    "./next": {
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./next/plugin": {
      "import": "./dist/next-plugin.js",
      "require": "./dist/next-plugin.cjs"
    },
    "./next/precompute": {
      "import": "./dist/next-precompute.js",
      "require": "./dist/next-precompute.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "next/plugin": [
        "dist/next-plugin.d.ts",
        "dist/next-plugin.d.cts"
      ],
      "next/precompute": [
        "dist/next-precompute.d.ts",
        "dist/next-precompute.d.cts"
      ],
      "config": [
        "dist/config-module.d.ts",
        "dist/config-module.d.cts"
      ],
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "attw": "attw --pack .",
    "build": "tsup",
    "dev": "tsup --watch --clean=false",
    "prepublishOnly": "node scripts/check-temporary.mjs",
    "check": "biome check",
    "test": "vitest --run",
    "test:playground": "vitest --run playground --reporter=verbose",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc -p test/register/tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@openfeature/core": "1.12.0",
    "@openfeature/server-sdk": "1.23.0",
    "@types/node": "22.14.0",
    "next": "16.3.8",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0",
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "next": ">=15.4.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
