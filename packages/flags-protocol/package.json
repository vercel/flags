{
  "name": "@flags-sdk/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Prototype of filesystem sources and typed flags protocol imports",
  "keywords": [
    "feature flags",
    "flags protocol"
  ],
  "license": "MIT",
  "author": "Dominik Ferber <dominik@vercel.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/flags.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./next/config": {
      "types": "./dist/next-config.d.ts",
      "default": "./dist/next-config.js"
    },
    "./tooling": {
      "types": "./dist/generate.d.ts",
      "default": "./dist/generate.js"
    }
  },
  "bin": {
    "flags": "./bin/flags.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --clean=false",
    "check": "biome check",
    "type-check": "tsc --noEmit",
    "test": "pnpm build && node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@next/env": "16.3.8"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "catalog:",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "8.5.1",
    "typescript": "^5.9.3"
  }
}
