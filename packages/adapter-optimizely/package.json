{
  "name": "@flags-sdk/optimizely",
  "version": "0.1.1",
  "description": "A provider for the Flags Explorer",
  "keywords": [
    "optimizely",
    "flags explorer"
  ],
  "license": "MIT",
  "author": "Dominik Ferber <dominik@vercel.com>",
  "sideEffects": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/flags.git"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "typesVersions": {
    "*": {
      ".": [
        "dist/*.d.ts",
        "dist/*.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "tsup --watch --clean=false",
    "check": "biome check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.14.0",
    "flags": "workspace:*",
    "msw": "2.6.4",
    "rimraf": "6.1.2",
    "tsup": "8.5.1",
    "typescript": "5.6.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
