{
  "name": "@flags-sdk/statsig",
  "version": "0.3.1",
  "description": "An OpenFeature provider for Statsig and getProviderData for the Flags Explorer",
  "keywords": [
    "flags-sdk",
    "statsig",
    "dynamic config",
    "vercel",
    "global config",
    "experiments",
    "experimentation",
    "ab testing"
  ],
  "author": "Aaron Morris <aaron.morris@vercel.com>",
  "homepage": "https://flags-sdk.dev",
  "bugs": {
    "url": "https://github.com/vercel/flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/flags.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js",
      "require": "./dist/provider/index.cjs"
    },
    "./openfeature": {
      "types": "./dist/openfeature.d.ts",
      "import": "./dist/openfeature.js",
      "require": "./dist/openfeature.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "provider": [
        "./dist/provider/index.d.ts",
        "./dist/provider/index.d.cts"
      ],
      "openfeature": [
        "./dist/openfeature.d.ts",
        "./dist/openfeature.d.cts"
      ],
      ".": [
        "./dist/index.d.ts",
        "./dist/index.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "tsup --watch --clean=false",
    "check": "biome check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@openfeature/server-sdk": "1.23.0",
    "@statsig/statsig-node-core": "0.24.2",
    "@types/node": "22.14.0",
    "msw": "2.6.4",
    "rimraf": "6.1.2",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vite": "8.1.7",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.17.0",
    "@statsig/statsig-node-core": ">=0.24.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    },
    "@statsig/statsig-node-core": {
      "optional": true
    }
  }
}
