{
  "name": "@flags-sdk/tanstack-start",
  "description": "The TanStack Start binding of the Flags SDK",
  "version": "0.1.0-standard.0",
  "license": "MIT",
  "author": "Dominik Ferber <dominik@vercel.com>",
  "homepage": "https://flags-sdk.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/flags.git"
  },
  "bugs": {
    "url": "https://github.com/vercel/flags/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./binding": {
      "import": "./dist/binding.js",
      "require": "./dist/binding.cjs"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "binding": [
        "dist/binding.d.ts",
        "dist/binding.d.cts"
      ],
      "vite": [
        "dist/vite.d.ts",
        "dist/vite.d.cts"
      ],
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "biome check",
    "type-check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@flags-sdk/vite": "workspace:*"
  },
  "peerDependencies": {
    "flags": "workspace:*",
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "flags": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "@types/node": "22.14.0",
    "vitest": "4.1.11",
    "vite": "8.3.4"
  }
}
