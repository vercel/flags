        },
        {
          "type": "SYMBOL",
          "name": "false"
        },
        {
          "type": "SYMBOL",
          "name": "null"
        }
      ]
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "IMMEDIATE_TOKEN",
                      "content": {
                        "type": "PREC",
                        "value": 1,
                        "content": {
                          "type": "PATTERN",
                          "value": "[^\"\\\\\\n]+"
                        }
                      }
                    },
                    "named": true,
                    "value": "string_content"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "escape_sequence"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "IMMEDIATE_TOKEN",
                      "content": {
                        "type": "PREC",
                        "value": 1,
                        "content": {
                          "type": "PATTERN",
                          "value": "[^'\\\\\\n]+"
                        }
                      }
                    },
                    "named": true,
                    "value": "string_content"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "escape_sequence"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
