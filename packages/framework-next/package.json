{
  "name": "@flags-sdk/next",
  "description": "The Next.js integration of the Flags SDK",
  "version": "0.1.0-standard.0",
  "license": "MIT",
  "author": "Dominik Ferber <dominik@vercel.com>",
  "homepage": "https://flags-sdk.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/flags.git"
  },
  "bugs": {
    "url": "https://github.com/vercel/flags/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./binding": {
      "import": "./dist/binding.js",
      "require": "./dist/binding.cjs"
    },
    "./manifest": {
      "import": "./dist/manifest.js",
      "require": "./dist/manifest.cjs"
    },
    "./manifest-loader": {
      "import": "./dist/manifest-loader.js",
      "require": "./dist/manifest-loader.cjs"
    },
    "./plugin": {
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    }
  },
  "main": "./dist/index.js",
  "typesVersions": {
    "*": {
      "binding": [
        "dist/binding.d.ts",
        "dist/binding.d.cts"
      ],
      "manifest": [
        "dist/manifest.d.ts",
        "dist/manifest.d.cts"
      ],
      "manifest-loader": [
        "dist/manifest-loader.d.ts",
        "dist/manifest-loader.d.cts"
      ],
      "plugin": [
        "dist/plugin.d.ts",
        "dist/plugin.d.cts"
      ],
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "biome check",
    "type-check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "flags": "workspace:*",
    "next": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "flags": "workspace:*",
    "jose": "^5.10.0",
    "next": "16.4.6",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  }
}
