{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.development.local",
    "biome.json"
  ],
  "globalEnv": ["NPM_TOKEN", "DEPLOYMENT_PROTECTION_BYPASS"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "GLOBAL_CONFIG",
        "FLAGS_SECRET",
        "LAUNCHDARKLY_CLIENT_SIDE_ID",
        "LAUNCHDARKLY_PROJECT_SLUG",
        "FLAGS",
        "BACKEND_URL",
        "KV_URL",
        "KV_REST_API_READ_ONLY_TOKEN",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "REDIS_URL",
        "BLOB_READ_WRITE_TOKEN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".svelte-kit/**",
        ".vercel/**"
      ]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "attw": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["^start"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "^start"],
      "env": ["FLAGS_SECRET"]
    },
    "publint": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"]
    },
    "flags-sdk-launchdarkly#dev": {
      "dependsOn": ["flags#build", "@flags-sdk/launchdarkly#build"],
      "env": [
        "EXPERIMENTATION_CONFIG",
        "FLAGS_SECRET",
        "LAUNCHDARKLY_CLIENT_SIDE_ID",
        "LAUNCHDARKLY_PROJECT_SLUG"
      ],
      "cache": false
    },
    "flags-sdk-launchdarkly#build": {
      "dependsOn": ["flags#build", "@flags-sdk/launchdarkly#build"],
      "env": [
        "EXPERIMENTATION_CONFIG",
        "FLAGS_SECRET",
        "LAUNCHDARKLY_CLIENT_SIDE_ID",
        "LAUNCHDARKLY_PROJECT_SLUG"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "flags-sdk-launchdarkly#type-check": {
      "dependsOn": ["flags#build", "@flags-sdk/launchdarkly#build"]
    },
    "biome:check": {},
    "flags-sdk-flagsmith#build": {
      "dependsOn": ["flags#build", "@flags-sdk/flagsmith#build"],
      "env": ["FLAGS_SECRET", "FLAGSMITH_ENVIRONMENT_KEY"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "flags-sdk-flagsmith#dev": {
      "dependsOn": ["flags#build", "@flags-sdk/flagsmith#build"],
      "cache": false
    },
    "flags-sdk-flagsmith#type-check": {
      "dependsOn": ["flags#build", "@flags-sdk/flagsmith#build"]
    },
    "flags-sdk-statsig#dev": {
      "dependsOn": ["flags#build", "@flags-sdk/statsig#build"],
      "env": [
        "STATSIG_SERVER_API_KEY",
        "FLAGS_SECRET",
        "EXPERIMENTATION_CONFIG",
        "EXPERIMENTATION_CONFIG_ITEM_KEY"
      ],
      "cache": false
    },
    "flags-sdk-statsig#build": {
      "dependsOn": ["flags#build", "@flags-sdk/statsig#build"],
      "env": [
        "STATSIG_SERVER_API_KEY",
        "FLAGS_SECRET",
        "EXPERIMENTATION_CONFIG",
        "EXPERIMENTATION_CONFIG_ITEM_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "flags-sdk-statsig#type-check": {
      "dependsOn": ["flags#build", "@flags-sdk/statsig#build"]
    },
    "flags-sdk-vercel#dev": {
      "dependsOn": ["flags#build", "@flags-sdk/vercel#build"],
      "env": ["FLAGS", "FLAGS_SECRET"],
      "cache": false,
      "passThroughEnv": ["VERCEL_OIDC_TOKEN"]
    },
    "flags-sdk-vercel#build": {
      "dependsOn": ["flags#build", "@flags-sdk/vercel#build"],
      "env": ["FLAGS", "FLAGS_SECRET"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": ["VERCEL_OIDC_TOKEN"]
    },
    "flags-sdk-vercel#type-check": {
      "dependsOn": ["flags#build", "@flags-sdk/vercel#build"]
    },
    "flags-sdk-reflag#dev": {
      "dependsOn": ["flags#build", "@flags-sdk/reflag#build"],
      "env": ["FLAGS_SECRET", "REFLAG_SECRET_KEY"],
      "cache": false
    },
    "flags-sdk-reflag#build": {
      "dependsOn": ["flags#build", "@flags-sdk/reflag#build"],
      "env": ["FLAGS_SECRET", "REFLAG_SECRET_KEY"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "flags-sdk-reflag#type-check": {
      "dependsOn": ["flags#build", "@flags-sdk/reflag#build"]
    }
  }
}
