# Release plumbing — the workflow filename is bound to npm Trusted Publisher
# config, so a rename or behavioural change is a security-relevant edit.
# Keep these locked to the flags team explicitly.
/.github/workflows/release.yml @vercel/flags
/.github/workflows/tag-canary.yaml @vercel/flags
/.changeset/config.json           @vercel/flags
/.github/CODEOWNERS               @vercel/flags
