# Flagsmith environment's server-side SDK key (starts with ser.)
FLAGSMITH_ENVIRONMENT_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FLAGS_SECRET=

# Client-side environment key for metadata and dashboard links (not the ser. key)
FLAGSMITH_ENVIRONMENT_ID=
# Project ID from the Flagsmith dashboard URL
FLAGSMITH_PROJECT_ID=
