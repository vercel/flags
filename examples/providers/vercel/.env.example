# No SDK key is required when deploying to Vercel.
# Run "vercel link" and "vercel env pull .env.local" to obtain VERCEL_OIDC_TOKEN
# and FLAGS_SECRET. Vercel provides the OIDC token automatically on deployments.
# Pull again if your local OIDC token expires.

# Required by Flags Explorer; must match the linked project's environment.
# For Development, add it as a regular environment variable (Config), not a Secret.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
FLAGS_SECRET=""

# Optional for deployments outside Vercel:
# FLAGS=""
