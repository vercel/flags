{
  "name": "standard-example-sveltekit-codegen",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "The Flags SDK with SvelteKit and code generation of flags:self",
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm build && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@flags-sdk/sveltekit": "workspace:*",
    "@openfeature/core": "1.12.0",
    "@openfeature/server-sdk": "1.23.0",
    "flags": "workspace:*"
  }
}
