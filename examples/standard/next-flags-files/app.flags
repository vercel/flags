// The flags of the shop: the key of each flag, and what the code knows
// about it. The rules and the rollout stay in the flag management system.
// See https://flags-sdk.dev/docs/flags/flags-files
source self

flag summer-sale {
  description: "Shows the summer sale banner"
  defaultValue: false
}

flag checkout {
  description: "The checkout flow"
  options: ["control", { value: "express", label: "Express checkout" }]
  defaultValue: "control"
}
