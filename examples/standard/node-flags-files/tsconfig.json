{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowArbitraryExtensions": true
  },
  "contentMappers": [{ "package": "flags", "extensions": [".flags"] }],
  "include": ["src", "test", "flags"]
}
